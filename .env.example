# ==============================================================================
# D-In-Sec Environment Configuration Template
# Copy this file to .env and supply actual values.
# NEVER commit .env or any real private keys to version control.
# ==============================================================================

# Google Gemini API Key for Module 2 Incident Classification
GEMINI_API_KEY="your_gemini_api_key_here"

# Module 3 RSA-2048 Signing Private Key (PEM format).
# Used by Module 2 to sign Merkle tree update payloads.
# Kept in memory only at runtime — NEVER written to disk.
# Can be provided as a single-line string with literal \n characters or multiline PEM:
# M3_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----"
M3_SIGNING_PRIVATE_KEY=""

# Module 3 Standalone Flask Engine Endpoint
M3_API_URL="http://127.0.0.1:5001/api/v1/tree/update"

# Optional: Module 1 Vault Encryption Key (Fernet 32-byte url-safe base64 string)
# If set, token vault keeps key in memory only and avoids writing vault.key to disk.
# VAULT_ENCRYPTION_KEY="your_fernet_base64_key_here"
