# ==============================================================================
# D-In-Sec Environment Configuration Template — M3 Sidecar (Phase 3+)
# Copy this file to .env and supply actual values.
# NEVER commit .env or any real private keys to version control.
# ==============================================================================

# ── Gemini / AI ───────────────────────────────────────────────────────────────
# Google Gemini API Key for AI breach alert generation and classification.
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini model to use (fast path / slow path falls back to smaller models)
GEMINI_MODEL="gemini-2.5-flash"

# ── Module 3 Core ─────────────────────────────────────────────────────────────
# Environment: dev | prod
# prod mode refuses to start without S3/KMS config and rejects dev keys.
M3_ENV="dev"

# Debug mode: 1 = Flask debug on (NEVER in prod). Gunicorn ignores this.
# Production: gunicorn -w 4 -b 127.0.0.1:5001 "m3.api:create_m3_app()" --timeout 120
M3_DEBUG="0"

# ── RSA Signing Key ───────────────────────────────────────────────────────────
# Module 3 RSA-2048 Signing Private Key (PEM format).
# Used by Module 2 to sign Merkle tree update payloads.
# Kept in memory only at runtime — NEVER written to disk.
# Can be provided as a single-line string with literal \n characters:
# M3_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...END PRIVATE KEY-----"
M3_SIGNING_PRIVATE_KEY=""

# ── API Keys & Auth ───────────────────────────────────────────────────────────
# API Keys — JSON object mapping SHA-256 hashed keys to role strings.
# Roles: ADMIN (full access), SERVICE (tree updates), VIEWER (read-only)
# In prod: keys are hashed with SHA-256; use M3_API_KEYS_HASHED=1
# In dev: plaintext keys are accepted if M3_ENV=dev.
M3_API_KEYS='{"admin-key-change-me": "ADMIN", "m2-service-key-change-me": "SERVICE", "viewer-key-change-me": "VIEWER"}'
M3_API_KEYS_HASHED="0"

# Module 2 uses this SERVICE key to authenticate /tree/update requests to M3
M3_SERVICE_API_KEY="m2-service-key-change-me"

# Module 2 uses this ADMIN key to register its public key with M3 on startup
M3_ADMIN_API_KEY="admin-key-change-me"

# Module 3 API endpoint (used by Module 2 tailer)
M3_API_URL="http://127.0.0.1:5001/api/v1/tree/update"

# ── Storage Backend ───────────────────────────────────────────────────────────
# STORAGE_BACKEND = local | s3
# local = JSON files on disk (dev/CI). s3 = AWS S3 with SSE-KMS (prod).
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="local_storage"

# AWS S3 configuration (required when STORAGE_BACKEND=s3)
S3_BUCKET="your-dinsec-audit-bucket"
AWS_REGION="ap-south-1"

# S3 retry interval in seconds (for pending_uploads worker)
STORAGE_RETRY_INTERVAL="60"

# ── KMS Signing Key ────────────────────────────────────────────────────────────
# SIGNER_BACKEND = local | kms
# local = RSA-2048 from M3_SIGNING_PRIVATE_KEY env (dev/CI)
# kms   = AWS KMS RSASSA_PSS_SHA_256 (prod). Private key never leaves KMS.
SIGNER_BACKEND="local"

# KMS key ID or alias for signing (e.g. alias/m3-sign-key or arn:aws:kms:...)
# Required when SIGNER_BACKEND=kms
KMS_KEY_ID=""

# KMS key ID or alias for data encryption (SSE-KMS on S3)
# Required when STORAGE_BACKEND=s3
KMS_DATA_KEY_ID=""

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
# Default tenant ID (used for S3 key namespacing and master root isolation)
TENANT_ID="default"

# ── Security (Phase 3) ────────────────────────────────────────────────────────
# HMAC request signing: 1 = enabled (X-Signature header required)
HMAC_SIGNING_ENABLED="0"
# Shared HMAC secret (32+ bytes, random)
HMAC_SECRET=""
# Max allowed clock skew for X-Timestamp header (seconds)
HMAC_SKEW_SECONDS="300"

# CORS allowed origins (comma-separated list). Empty = no CORS.
CORS_ORIGINS=""

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_KEY="100/minute"
RATE_LIMIT_PER_IP="200/minute"
MAX_CONTENT_LENGTH_BYTES="1048576"

# ── Webhook / Alert Notifiers (Phase 4) ───────────────────────────────────────
# Webhook URL for breach/tamper alerts
WEBHOOK_URL=""
# AWS SNS Topic ARN for alerts (optional)
SNS_TOPIC_ARN=""

# ── Optional: Module 1 Vault ──────────────────────────────────────────────────
# Fernet 32-byte url-safe base64 string. If set, vault avoids writing vault.key to disk.
# VAULT_ENCRYPTION_KEY="your_fernet_base64_key_here"
